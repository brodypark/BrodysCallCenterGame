# Copy this file to .env and fill in the keys. Only the server reads them.
# Never give them a VITE_ prefix: Vite sends VITE_ variables to the browser.

# Signs the player id cookie. Required in production: at least 32 random characters, e.g.
# from: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# In development a fixed fallback is used when this is empty.
COOKIE_SECRET=

# Victim replies (Gemini API), from https://aistudio.google.com/apikey. Leave empty for
# scripted replies (no AI, no cost). Restart the dev server after changing it.
GEMINI_API_KEY=
# Optional backup key, tried when the main one fails. Gemini's limits are per Google Cloud
# project, not per key, so make it in a different project for it to help with limits.
GEMINI_API_KEY_BACKUP=

# Victim voices and player speech-to-text (ElevenLabs)
ELEVENLABS_API_KEY=

# Optional, development only: a shorter shift for testing, in seconds (default 360).
# SHIFT_SECONDS=60

# Optional: turns on GET /backup, which downloads the saves database when sent with
# "Authorization: Bearer <ADMIN_SECRET>". Use at least 32 random characters (same command
# as COOKIE_SECRET). Leave empty to switch the route off.
ADMIN_SECRET=

# Optional: where the game server listens (defaults: 3000, and localhost in development or
# 0.0.0.0 in production so the host's proxy can reach it).
# PORT=3000
# HOST=localhost
